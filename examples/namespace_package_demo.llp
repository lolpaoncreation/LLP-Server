visibility: All

/* ===============================================================
   LLP Demonstration: Class Packages with namespace then ... end
   =============================================================== *\

namespace GameEngine then
    /- Package-wide variables shared across classes \
    int MaxEntities = 5000
    string EngineVersion = "3.2.0"

    /- Class declared inside package \
    class PhysicsWorld then
        int Gravity = -10
        string Name = "PhysicsEngine"
    end

    class AudioManager then
        int MasterVolume = 100
        string Name = "AudioEngine"
    end
end

print("=== ACCESSING NAMESPACE VARIABLES ===")
print("Engine version:", GameEngine.EngineVersion)
print("Maximum entities allowed:", GameEngine.MaxEntities)

print("\n=== INSTANTIATING CLASSES FROM NAMESPACE ===")
General root = Instance.new("EngineRoot")

General physics = GameEngine.PhysicsWorld.new(root)
print("PhysicsWorld instance:", physics)
print("Configured gravity:", physics.Gravity)

General audio = GameEngine.AudioManager.new(root)
print("AudioManager instance:", audio)
print("Master volume:", audio.MasterVolume)
