// ============================================================================
// Demonstration: Machine-Bound Hardware Security (HWID) & Ed25519 Signatures
// ============================================================================
visibility: All

print("==============================================================")
print("🔒 LLP - MACHINE-BOUND HARDWARE SECURITY & ED25519 SIGNATURES")
print("==============================================================")

// 1. Immutable Hardware Fingerprint
General devId = Device.GetId()
General fingerprint = Device.GetFingerprint()
General sealed = Device.IsKeySealed()
General pubKey = Device.GetPublicKey()

print("[1] Host Device Identity:")
print("    - Device ID:", devId)
print("    - HWID Fingerprint (HMAC-SHA256):", fingerprint)
print("    - Ed25519 Key sealed to local hardware:", sealed)

// 2. Dynamic Cryptographic Signing
General method = "POST"
General path = "/api/rpc"
General payload = "{\"service\":\"Orders\",\"method\":\"get\",\"args\":[12]}"

General sigInfo = Device.SignPayload(method, path, payload)
print("\n[2] RPC Frame Cryptographic Signature:")
print("    - Anti-replay nonce:", sigInfo.nonce)
print("    - Timestamp:", sigInfo.timestamp)
print("    - Ed25519 signature:", sigInfo.signature)

// 3. Signature Verification
General isValid = Device.VerifySignature(pubKey, sigInfo.signature, sigInfo.nonce, sigInfo.timestamp, method, payload)
print("    - Mathematically verified signature:", isValid)

// 4. Tamper Test on Altered Payload
General alteredPayload = "{\"service\":\"Orders\",\"method\":\"get\",\"args\":[9999]}"
General isAlteredValid = Device.VerifySignature(pubKey, sigInfo.signature, sigInfo.nonce, sigInfo.timestamp, method, alteredPayload)
print("    - Tampered payload verified (must be false):", isAlteredValid)

// 5. Fleet Management & Emergency Revocation (Server-Side)
print("\n[3] Device Fleet Management & Emergency Revocation (Server):")
Server.RevokeDevice(devId)
General isRevoked = Server.IsDeviceRevoked(devId)
print("    - Immediate device revocation:", isRevoked)

Server.UnrevokeDevice(devId)
General isStillRevoked = Server.IsDeviceRevoked(devId)
print("    - Revocation status after rehabilitation:", isStillRevoked)

print("\n✨ Hardware & cryptographic security 100% operational!")
