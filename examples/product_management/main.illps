/* ===================================================
   Interface Stylesheet (.illps) - Lolpaon Pro
   Premium Dark Theme
   =================================================== */

Background#ProductManagementWindow {
    background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #0f172a 100%);
    color: #f8fafc;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    padding: 24px;
}

Card#TopBarCard {
    background: rgba(30, 41, 59, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(148, 163, 184, 0.15);
    border-radius: 12px;
    padding: 16px 20px;
    margin-bottom: 20px;
}

Text#AppHeaderTitle {
    font-size: 20px;
    font-weight: 700;
    color: #38bdf8;
}

Text#HeaderInactivityBadge {
    background: rgba(34, 197, 94, 0.15);
    color: #4ade80;
    border: 1px solid rgba(74, 222, 128, 0.3);
    padding: 4px 12px;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 600;
}

Card#StatsKpiCard {
    background: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(148, 163, 184, 0.12);
    border-radius: 12px;
    padding: 16px 20px;
    margin-bottom: 20px;
}

Text#KpiTotalProducts, Text#KpiStockValue, Text#KpiCategories {
    font-size: 16px;
    font-weight: 600;
    color: #f1f5f9;
}

Card#CatalogManagementCard {
    background: rgba(30, 41, 59, 0.85);
    border: 1px solid rgba(148, 163, 184, 0.15);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
}

TextInput#ProductSearchInput {
    background: #0f172a;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 8px;
    color: #f8fafc;
    padding: 10px 14px;
}

Button#BtnOpenAddModal {
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    color: #ffffff;
    font-weight: 600;
    border-radius: 8px;
    padding: 10px 18px;
    border: none;
}

Card#CardP1, Card#CardP2, Card#CardP3, Card#CardP4, Card#CardP5, Card#CardP6 {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(148, 163, 184, 0.15);
    border-radius: 10px;
    padding: 14px;
}

Card#AddProductSectionCard {
    background: rgba(30, 41, 59, 0.85);
    border: 1px solid rgba(148, 163, 184, 0.15);
    border-radius: 12px;
    padding: 20px;
}

Button#BtnSubmitProduct {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: #ffffff;
    font-weight: 700;
    border-radius: 8px;
    padding: 12px 24px;
    border: none;
}

Modal#InactivityAlertModal {
    background: #1e293b;
    border: 2px solid #ef4444;
    border-radius: 16px;
    padding: 24px;
}

Text#InactivityModalNotice {
    color: #f8fafc;
    font-size: 15px;
    margin-bottom: 12px;
}

Text#InactivityModalCountdown {
    color: #f87171;
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 16px;
}

Button#BtnStayConnected {
    background: #22c55e;
    color: #ffffff;
    font-weight: 700;
    border-radius: 8px;
    padding: 10px 20px;
}

Button#BtnConfirmLogout {
    background: #ef4444;
    color: #ffffff;
    font-weight: 700;
    border-radius: 8px;
    padding: 10px 20px;
}
