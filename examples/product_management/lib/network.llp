visibility: All

/* ===================================================
   Librairie Standard LLP : Network (Réseau et Clients API) (Lecture Seule)
   Requêtes HTTP GET/POST et communications socket
   =================================================== *\

func FetchEndpoint(string targetUrl) {
    return Network.Get(targetUrl)
}

func SubmitPayload(string targetUrl, General payloadData) {
    return Network.Post(targetUrl, payloadData)
}
