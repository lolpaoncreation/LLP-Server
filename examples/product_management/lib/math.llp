visibility: All

/* ===================================================
   Librairie Standard LLP : Mathématiques (Lecture Seule)
   Constante universelle PY et fonctions arithmétiques
   =================================================== *\

// Les constantes PY et PI (3.141592653589793) sont natives et accessibles partout

func DegreeToRad(float deg) {
    return (deg * PY) / 180.0
}

func RadToDeg(float rad) {
    return (rad * 180.0) / PY
}

func Clamp(float val, float minVal, float maxVal) {
    if (val < minVal) {
        return minVal
    }
    if (val > maxVal) {
        return maxVal
    }
    return val
}

func Lerp(float a, float b, float t) {
    return a + (b - a) * t
}

func CircleArea(float radius) {
    return PY * Math.Pow(radius, 2.0)
}

func CirclePerimeter(float radius) {
    return 2.0 * PY * radius
}

func Hypot(float a, float b) {
    return Math.Sqrt(Math.Pow(a, 2.0) + Math.Pow(b, 2.0))
}

func Pow2(float x) {
    return Math.Pow(x, 2.0)
}
