visibility: All

/* ===================================================
   Librairie Standard LLP : ProbLlp (Probabilités et Combinatoire) (Lecture Seule)
   Calculs de combinatoire, lois discrètes et continues
   =================================================== *\

func ProductBundleCombinations(int totalProducts, int bundleSize) {
    return ProbLlp.Combinations(totalProducts, bundleSize)
}

func SequencePermutations(int totalItems, int selectedItems) {
    return ProbLlp.Permutations(totalItems, selectedItems)
}

func CalculateFactorial(int n) {
    return ProbLlp.Factorial(n)
}

func DemandPoissonProbability(int demandUnits, float lambdaMean) {
    return ProbLlp.Poisson(demandUnits, lambdaMean)
}

func SalesBinomialProbability(int successes, int trials, float probSuccess) {
    return ProbLlp.Binomial(successes, trials, probSuccess)
}

func NormalDemandDensity(float x, float mean, float stdDev) {
    return ProbLlp.NormalPDF(x, mean, stdDev)
}
