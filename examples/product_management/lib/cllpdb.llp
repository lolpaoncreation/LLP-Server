visibility: All

/* ===================================================
   Librairie Standard LLP : CLLPDB (Base de Données Chiffrée AES) (Lecture Seule)
   Gestion de session chiffrée, requêtes UTF-8 et transactions
   =================================================== *\

func ConnectDatabase(string databasePath) {
    return CLLPDB.Open(databasePath)
}

func AuthenticateSession(General dbInstance, string username, string password) {
    return dbInstance.StartSession(username, password)
}

func CheckSessionRemaining(General dbInstance) {
    return dbInstance.GetRemainingSession()
}

func QueryCatalog(General dbInstance) {
    return dbInstance.Query("SELECT * FROM products")
}

func QueryCategories(General dbInstance) {
    return dbInstance.Query("SELECT * FROM categories")
}

func QueryUsers(General dbInstance) {
    return dbInstance.Query("SELECT * FROM users")
}
