visibility: All

/* ===================================================
   Librairie Standard LLP : Crypto (Cryptographie Unique) (Lecture Seule)
   Chiffrement AES-256 et hachage sécurisé SHA-256
   =================================================== *\

func RetrieveUniqueKey() {
    return Crypto.GetProjectKey()
}

func EncryptSecret(string plainText, string secretKey) {
    return Crypto.Encrypt(plainText, secretKey)
}

func DecryptSecret(string cipherText, string secretKey) {
    return Crypto.Decrypt(cipherText, secretKey)
}

func ComputeHash(string plainText) {
    return Crypto.Sha256(plainText)
}
