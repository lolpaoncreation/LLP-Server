visibility: All

/* ===================================================
   Lolpaon Advanced Interface (.illp) : Rich Showcase
   Components: Stack, ResponsiveGrid, DataGrid, Kanban,
               Chart, Drawer, Modal, TagPicker, DatePicker,
               RichEditor, FileUpload, ColorPicker, Skeleton,
               Toast, MediaPlayer, Webview (Escape Hatch)
   =================================================== *\

Background "MainWindow" responsive: true minWidth: "500px" maxWidth: "1400px" {
    Stack "HeaderStack" direction: "horizontal" gap: "16px" align: "center" {
        Text "AppTitle" content: "🚀 Entreprise Cloud Console (LLP v1.4)"
        Toast "WelcomeToast" type: "success" message: "Connecté avec identité matérielle Device validée ✓"
    }

    Divider "Div1"

    ResponsiveGrid "DashboardMetricsGrid" columns: 12 gap: "16px" {
        Chart "SalesTrendChart" type: "bar" title: "Volume de Ventes & Trafic Réseau" rpcSource: "Analytics.GetSales" colSpanDesktop: 8 colSpanMobile: 12

        Stack "SideControlStack" direction: "vertical" gap: "12px" align: "stretch" colSpanDesktop: 4 colSpanMobile: 12 {
            TagPicker "CategoryTags" rpcSearch: "Catalog.SearchTags" debounce: 300 placeholder: "Filtrer par tags..."
            DatePicker "DateFilter" mode: "range" defaultRange: "Last30Days" onChange: "Analytics.SetDate"
            ColorPicker "ThemeColor" defaultColor: "#89b4fa"
        }
    }

    Divider "Div2"

    Stack "MainDataStack" direction: "vertical" gap: "20px" align: "stretch" {
        Card "CatalogCard" title: "Catalogue Matériel & Inventaire Distant" {
            DataGrid "ProductInventoryGrid" rpcSource: "Catalog.GetProducts" pageSize: 25 virtualScroll: true
        }

        Card "KanbanCard" title: "Gestion des Déploiements & Tâches" {
            Kanban "DeployBoard" rpcSource: "Tasks.GetBoard" onCardDrop: "Tasks.MoveCard"
        }
    }

    Divider "Div3"

    ResponsiveGrid "BottomToolsGrid" columns: 12 gap: "16px" {
        Card "EditorCard" title: "Documentation & Changelog" colSpanDesktop: 6 colSpanMobile: 12 {
            RichEditor "ReleaseNotes" mode: "markdown" minHeight: "180px" placeholder: "Rédigez la notice ou description technique..."
        }

        Card "StorageCard" title: "Téléversement de Ressources" colSpanDesktop: 6 colSpanMobile: 12 {
            FileUpload "FirmwareUpload" rpcUpload: "Storage.Upload" maxSize: "50MB"
            Skeleton "LoadingPlaceholder" lines: 2 type: "card"
        }
    }

    Drawer "ConfigDrawer" title: "Paramètres Avancés & Réseau" position: "right" width: "400px" {
        Text "DrawerNotice" content: "Configuration matérielle et quotas RPC."
        MediaPlayer "PreviewPlayer" type: "image" src: "assets/rack_preview.png"
    }

    Modal "SecurityModal" title: "Vérification d'Accès Matériel" width: "520px" {
        Text "ModalContent" content: "Le token matériel SHA-256 de votre appareil est actif et infalsifiable."
        Button "BtnConfirm" text: "Confirmer la Session"
    }

    Webview "EscapeHatchPorte" minHeight: "220px"
}
