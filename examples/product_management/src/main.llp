// ===================================================
// Complete Application: Product Management (LLP)
// Demonstration: .cllpdb Authentication, Navigation,
// Inactivity Session Management (2 min idle -> 45 min countdown),
// Product catalog entry form, and scientific computing (SciLlp, SymLlp, ProbLlp).
// ===================================================

print("===================================================")
print("   Product Management Application - Lolpaon Pro")
print("===================================================")

// 1. Universal Constant PY and Project Unique Encryption Key
print("\n[1. Global Configuration & Libraries]")
print("Universal PY constant:", PY)
print("Unique project encryption key:", Crypto.GetProjectKey())

// 2. Encrypted Database Connection (.cllpdb)
print("\n[2. Encrypted Database Connection (.cllpdb)]")
General db = CLLPDB.Open("data/products.cllpdb")

// Authentication & Inactivity Monitoring
// Inactivity rule:
// - If the user performs no actions (mouse, keyboard, click) for 2 minutes:
//   -> An alert countdown of 45 minutes begins.
// - During these 45 minutes, the user can click "Stay Connected" to reset the timer.
// - After 45 minutes of complete inactivity, the session is closed and the database is locked.
bool isConnected = db.StartSession("admin", "admin123")
print("Administrator authentication successful?", isConnected)
print("Remaining active session time (seconds):", db.GetRemainingSession())

if (isConnected) {
    // 3. Inspect Tables & Product Catalog
    print("\n[3. Inspect Database Tables & Product Catalog]")
    General userList = db.Query("SELECT * FROM users")
    print("Registered users in .cllpdb:", userList)

    General categoryList = db.Query("SELECT * FROM categories")
    print("Available categories:", categoryList)

    General productList = db.Query("SELECT * FROM products")
    print("Complete product catalog:", productList)

    // 4. Mathematical Calculations with PY (Circular price badge design)
    print("\n[4. Graphical Layout Calculations with Math & PY]")
    float badgeRadius = 25.0
    float badgeArea = PY * Math.Pow(badgeRadius, 2)
    print("Promotional badge radius (px):", badgeRadius)
    print("Calculated circular badge area (Math.Pow + PY):", Math.Round(badgeArea), "px²")

    // 5. Validation and Adding a New Product
    print("\n[5. Form Validation & Product Creation]")
    string newName = "Pro USB Podcast Studio Microphone"
    float newPrice = 89.90
    int newStock = 35

    bool nameValid = UIValidator.ValidateRequired(newName)
    bool priceValid = UIValidator.ValidateNumber(newPrice)

    if (nameValid && priceValid) {
        db.Execute("INSERT INTO products VALUES (106, \"Pro USB Podcast Studio Microphone\", 89.90, 35, 3);")
        UIValidator.ShowSuccess("New product inserted into .cllpdb database successfully!")
    } else {
        UIValidator.ShowError("Form", "The entered product details are invalid.")
    }

    // 6. Statistical & Scientific Computing (SciLlp)
    print("\n[6. Sales Statistics & Analysis (SciLlp)]")
    General cartPrices = General{1299.99, 129.50, 59.90, 249.00, 449.00, 89.90}
    print("Average cart value (SciLlp.Mean):", Math.Round(SciLlp.Mean(cartPrices)), "$")
    print("Price standard deviation (SciLlp.StdDev):", Math.Round(SciLlp.StdDev(cartPrices)), "$")

    General salesSignal = General{10.0, 15.0, 14.0, 25.0, 30.0, 28.0, 40.0}
    print("Moving average sales trend (SciLlp.MovingAverage):", SciLlp.MovingAverage(salesSignal, 3))

    // 7. Symbolic Mathematics & Calculus (SymLlp)
    print("\n[7. Economic Modeling & Symbolic Math (SymLlp)]")
    print("Symbolic derivative of cost C(x) = 3*x^2 + 5*x - 2:", SymLlp.Derivative("3*x^2 + 5*x - 2", "x"))
    print("Symbolic integral of revenue R(x) = 3*x^2 + 2*x:", SymLlp.Integral("3*x^2 + 2*x", "x"))
    print("Break-even threshold solution (2*x + 4 = 100):", SymLlp.Solve("2*x + 4 = 100", "x"))

    // 8. Demand Probabilities & Inventory Forecasting (ProbLlp)
    print("\n[8. Demand Probabilities & Inventory (ProbLlp)]")
    print("Possible 3-product bundle combinations out of 6:", ProbLlp.Combinations(6, 3))
    print("Probability of selling exactly 4 units (Poisson lambda=3.5):", Math.Round(ProbLlp.Poisson(4, 3.5) * 100), "%")
}

print("\n===================================================")
print("Launching Interactive Graphical Application!")
print("Inactivity Management: 2 min idle -> 45 min countdown")
print("===================================================")
// Launch application server and Lolpaon Pro graphical window
App.Launch(DevMode: True)
