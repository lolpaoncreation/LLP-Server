visibility: All

/* ===================================================
   Dashboard Styles (.illps) - Page 2
   =================================================== *\

Background.DashboardWindow {
    background: #11111b
    padding: 24px
    responsive: true
}

Card#TopBarCard {
    background: #1e1e2e
    border: 1px solid #313244
    borderRadius: 12px
    padding: 16px
    marginBottom: 16px
}

Text#DashboardTitle {
    color: #89b4fa
    fontSize: 20px
    font: bold
}

Button#BtnLogout {
    background: #f38ba8
    color: #11111b
    fontSize: 13px
    font: bold
    borderRadius: 6px
    padding: 8px 16px
}

Text#SessionInfo {
    color: #a6adc8
    fontSize: 12px
}

Card#StatsCard {
    background: #181825
    border: 1px solid #313244
    borderRadius: 12px
    padding: 16px
    marginBottom: 16px
}

Text#KpiProducts {
    color: #a6e3a1
    fontSize: 18px
    font: bold
    align: center
}

Text#KpiValue {
    color: #fab387
    fontSize: 18px
    font: bold
    align: center
}

Text#KpiCategories {
    color: #cba6f7
    fontSize: 18px
    font: bold
    align: center
}

Card#CatalogCard {
    background: #1e1e2e
    border: 1px solid #313244
    borderRadius: 12px
    padding: 20px
    marginBottom: 16px
}

Button#BtnNewProduct {
    background: #a6e3a1
    color: #11111b
    fontSize: 14px
    font: bold
    borderRadius: 8px
    padding: 10px 18px
}

Modal#ModalAddProduct {
    background: #181825
    border: 2px solid #89b4fa
    borderRadius: 16px
    padding: 24px
}

Text#ModalDesc {
    color: #cdd6f4
    fontSize: 14px
    marginBottom: 14px
}

Button#BtnSubmitAdd {
    background: #89b4fa
    color: #11111b
    fontSize: 14px
    font: bold
    borderRadius: 8px
    padding: 10px 20px
}

Button#BtnCloseModal {
    background: #45475a
    color: #cdd6f4
    fontSize: 14px
    borderRadius: 8px
    padding: 10px 20px
}
