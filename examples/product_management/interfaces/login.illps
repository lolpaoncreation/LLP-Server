visibility: All

/* ===================================================
   Login Styles (.illps) - Page 1
   =================================================== *\

Background.LoginWindow {
    background: #11111b
    padding: 30px
    responsive: true
}

Card#LoginCard {
    background: #1e1e2e
    border: 1px solid #313244
    borderRadius: 14px
    padding: 24px
}

Image#LoginLogo {
    width: 60px
    height: 60px
    borderRadius: 10px
}

Text#LoginTitle {
    color: #cdd6f4
    fontSize: 20px
    font: bold
}

Text#LoginSubtitle {
    color: #a6adc8
    fontSize: 13px
    marginBottom: 16px
}

TextInput#InputUsername {
    background: #313244
    color: #ffffff
    border: 1px solid #45475a
    borderRadius: 8px
    padding: 12px 14px
    marginBottom: 12px
}

TextInput#InputPassword {
    background: #313244
    color: #ffffff
    border: 1px solid #45475a
    borderRadius: 8px
    padding: 12px 14px
    marginBottom: 14px
}

Checkbox#CheckSession {
    color: #a6e3a1
    fontSize: 13px
    marginBottom: 18px
}

Button#BtnLogin {
    background: #89b4fa
    color: #11111b
    fontSize: 15px
    font: bold
    borderRadius: 8px
    padding: 12px 20px
    align: center
}
