visibility: All

/* ===================================================
   Full Application: Product Management (Lolpaon Pro)
   File: main.illp
   Features:
   - User authentication with encrypted database (.cllpdb)
   - Inactivity session monitoring (2 min idle -> 45 min countdown)
   - Real-time search and filtering of catalog products
   - Product addition and deletion with persistence in products.cllpdb
   =================================================== *\

Background "ProductManagementWindow" responsive: true minWidth: "480px" maxWidth: "1200px" minHeight: "860px" {
    Card "TopBarCard" title: "Lolpaon Store Pro - Product Management" {
        Row "TopBarRow" {
            Text "AppHeaderTitle" content: "📦 Lolpaon Store Pro - Product Management"
            Text "HeaderInactivityBadge" content: "🟢 Active (Idle: 2m | Alert: 45m)"
            Button "BtnLogout" text: "⮌ Sign Out"
        }
        Row "SessionDetailsRow" {
            Text "SessionStatusText" content: "Database: data/products.cllpdb (AES-256 Encrypted) | Connected User: admin (Administrator)"
            ProgressBar "SessionProgressBar" value: 95 max: 100
        }
    }

    Card "StatsKpiCard" title: "Key Inventory Metrics" {
        Grid "KpiGrid" columns: 3 {
            Text "KpiTotalProducts" content: "📦 6 Active Products"
            Text "KpiStockValue" content: "💰 $2,277.29 Total Stock Value"
            Text "KpiCategories" content: "🏷️ 3 Managed Categories"
        }
    }

    Card "CatalogManagementCard" title: "Database Product Catalog" {
        Row "CatalogToolbarRow" {
            TextInput "ProductSearchInput" placeholder: "🔍 Search by name or reference..."
            ItemBox "CategoryFilterSelect" default: "All Categories" items: ["All Categories", "Computers & PCs", "Peripherals", "Audio & Sound"]
            Button "BtnOpenAddModal" text: "➕ Add Product"
        }

        Grid "ProductsGridDisplay" columns: 3 {
            Card "CardP1" title: "💻 Pro 16 Laptop" {
                Text "P1Price" content: "Price: $1299.99 | Stock: 15 units"
                Text "P1Category" content: "Category: Computers & PCs"
            }
            Card "CardP2" title: "⌨️ Mechanical RGB Keyboard" {
                Text "P2Price" content: "Price: $129.50 | Stock: 42 units"
                Text "P2Category" content: "Category: Peripherals"
            }
            Card "CardP3" title: "🖱️ Ergonomic Wireless Mouse" {
                Text "P3Price" content: "Price: $59.90 | Stock: 80 units"
                Text "P3Category" content: "Category: Peripherals"
            }
            Card "CardP4" title: "🎧 Noise Cancelling Headphones" {
                Text "P4Price" content: "Price: $249.00 | Stock: 28 units"
                Text "P4Category" content: "Category: Audio & Sound"
            }
            Card "CardP5" title: "🖥️ 27'' 4K Ultra-Sharp Monitor" {
                Text "P5Price" content: "Price: $449.00 | Stock: 19 units"
                Text "P5Category" content: "Category: Computers & PCs"
            }
            Card "CardP6" title: "🎙️ Studio USB Microphone" {
                Text "P6Price" content: "Price: $89.90 | Stock: 35 units"
                Text "P6Category" content: "Category: Audio & Sound"
            }
        }
    }

    Card "AddProductSectionCard" title: "Add New Product (.cllpdb)" {
        Grid "AddProductFormGrid" columns: 2 {
            TextInput "InputProductName" placeholder: "Product name (e.g. 4K Webcam Pro)..."
            TextInput "InputProductPrice" placeholder: "Unit price ($)..."
            TextInput "InputProductStock" placeholder: "Stock quantity..."
            ItemBox "SelectProductCategory" default: "Computers & PCs" items: ["Computers & PCs", "Peripherals", "Audio & Sound"]
        }
        Row "AddProductActionsRow" {
            Button "BtnSubmitProduct" text: "💾 Save to .cllpdb"
            Button "BtnResetForm" text: "Clear"
        }
    }

    Modal "InactivityAlertModal" title: "⚠️ Inactive Session Alert" width: "480px" {
        Text "InactivityModalNotice" content: "You have been inactive for more than 2 minutes."
        Text "InactivityModalCountdown" content: "Time remaining before auto-logout: 45:00"
        ProgressBar "InactivityCountdownBar" value: 100 max: 100
        Row "InactivityModalButtonsRow" {
            Button "BtnStayConnected" text: "🟢 Stay Connected"
            Button "BtnConfirmLogout" text: "⮌ Sign Out Now"
        }
    }
}
