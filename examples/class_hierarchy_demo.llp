visibility: All

/* ===============================================================
   LLP Demonstration: Classes, Parent-Child Hierarchy & ToString()
   =============================================================== *\

class Hero then
    string Name = "Arthur"
    int Level = 1
end

/- 1. Tree hierarchy creation \
General gameRoot = Instance.new("Game")
gameRoot.Name = "MyGame"

General world = Instance.new("World", gameRoot)
world.Name = "NorthernKingdom"

General player = Hero.new(world)
player.Name = "KingArthur"

/- 2. Default object string representation: automatic hierarchical ToString() \
print("Output via print:", player)
print("Output via player.ToString():", player.ToString())

/- 3. An object without a parent simply displays its name \
General solo = Hero.new()
solo.Name = "LoneWarrior"
print("Object without parent:", solo)
