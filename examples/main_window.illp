visibility: All

/* ===================================================
   Lolpaon Interface (.illp): Declarative WYSIWYG UI
   Full Example with Containers & Nested Components
   Components: Card, Grid, Row, Text, TextInput, Button, Checkbox, ProgressBar, ListButton, ItemBox, Image, Divider
   Responsiveness is enabled via 'responsive: true'
   =================================================== *\

Background "MainWindow" responsive: true minWidth: "380px" maxWidth: "900px" minHeight: "560px" {
    Card "HeaderCard" title: "Workspace - Lolpaon Studio" {
        Row "BrandingRow" {
            Image "AppLogo" src: "assets/logo.png"
            Text "MainTitle" content: "Lolpaon Studio Pro"
        }

        Row "ProgressRow" {
            Text "StatusLabel" content: "Initializing system..."
            ProgressBar "SystemProgressBar" value: 85 max: 100
        }

        Row "DividerRow" {
            Divider "HeaderDivider"
        }
    }

    Card "ProfileCard" title: "Profile Settings & Configuration" {
        Grid "CredentialsGrid" columns: 2 {
            TextInput "InputUsername" placeholder: "Enter username..."
            TextInput "InputPassword" placeholder: "Enter password..."
        }

        Grid "OptionsGrid" columns: 2 {
            ListButton "RoleChoice" choices: ["Administrator", "Developer", "Guest"]
            ItemBox "ThemeSelector" default: "Dark Theme" items: ["Dark Theme", "Light Theme", "Cyberpunk Theme"]
        }

        Row "PreferencesRow" {
            Checkbox "CheckRemember" label: "Remember me" checked: true
            Checkbox "CheckSSL" label: "Secure SSL connection" checked: true
        }
    }

    Card "ActionsCard" title: "Actions & Validation" {
        Row "ButtonsRow" {
            Button "BtnSignIn" text: "Sign In"
            Button "BtnReset" text: "Reset"
        }
    }
}
