visibility: All

/* ===================================================
   Lolpaon Interface Stylesheet (.illps)
   Styles applied to containers, sub-containers, and widgets
   Directly integrated and applied in real-time to .illp views
   =================================================== *\

Background.MainWindow {
    background: #181825
    padding: 24px
    responsive: true
}

Card#HeaderCard {
    background: #1e1e2e
    border: 1px solid #313244
    borderRadius: 12px
    padding: 16px
    marginBottom: 16px
}

Card#ProfileCard {
    background: #1e1e2e
    border: 1px solid #313244
    borderRadius: 12px
    padding: 16px
    marginBottom: 16px
}

Card#ActionsCard {
    background: #1e1e2e
    border: 1px solid #313244
    borderRadius: 12px
    padding: 16px
    marginBottom: 16px
}

Image#AppLogo {
    width: 54px
    height: 54px
    borderRadius: 8px
}

Text#MainTitle {
    color: #cdd6f4
    fontSize: 20px
    font: bold
}

Text#StatusLabel {
    color: #a6adc8
    fontSize: 13px
    marginBottom: 6px
}

TextInput#InputUsername {
    background: #313244
    color: #ffffff
    border: 1px solid #45475a
    borderRadius: 8px
    padding: 10px 14px
}

TextInput#InputPassword {
    background: #313244
    color: #ffffff
    border: 1px solid #45475a
    borderRadius: 8px
    padding: 10px 14px
}

ListButton#RoleChoice {
    background: #45475a
    color: #cdd6f4
    borderRadius: 6px
}

ItemBox#ThemeSelector {
    background: #313244
    color: #fab387
    borderRadius: 8px
    padding: 10px
}

Checkbox#CheckRemember {
    color: #cdd6f4
    fontSize: 13px
}

Checkbox#CheckSSL {
    color: #a6e3a1
    fontSize: 13px
}

Button#BtnSignIn {
    background: #89b4fa
    color: #11111b
    fontSize: 15px
    font: bold
    borderRadius: 8px
    padding: 10px 20px
}

Button#BtnReset {
    background: #45475a
    color: #cdd6f4
    fontSize: 15px
    borderRadius: 8px
    padding: 10px 20px
}
