visibility: All

/* ===================================================
   Interface Lolpaon Style (.illps)
   Styles appliqués aux conteneurs, sous-conteneurs et composants
   Directement intégré et appliqué en temps réel dans l'interface .illp
   =================================================== *\

Background.FenetrePrincipale {
    background: #181825
    padding: 24px
    responsive: true
}

Card#CarteEnTete {
    background: #1e1e2e
    border: 1px solid #313244
    borderRadius: 12px
    padding: 16px
    marginBottom: 16px
}

Card#CarteFormulaire {
    background: #1e1e2e
    border: 1px solid #313244
    borderRadius: 12px
    padding: 16px
    marginBottom: 16px
}

Card#CarteActions {
    background: #1e1e2e
    border: 1px solid #313244
    borderRadius: 12px
    padding: 16px
    marginBottom: 16px
}

Image#LogoApp {
    width: 54px
    height: 54px
    borderRadius: 8px
}

Text#TitrePrincipal {
    color: #cdd6f4
    fontSize: 20px
    font: bold
}

Text#LabelStatut {
    color: #a6adc8
    fontSize: 13px
    marginBottom: 6px
}

TextInput#InputIdentifiant {
    background: #313244
    color: #ffffff
    border: 1px solid #45475a
    borderRadius: 8px
    padding: 10px 14px
}

TextInput#InputMotDePasse {
    background: #313244
    color: #ffffff
    border: 1px solid #45475a
    borderRadius: 8px
    padding: 10px 14px
}

ListButton#ChoixRole {
    background: #45475a
    color: #cdd6f4
    borderRadius: 6px
}

ItemBox#SelecteurTheme {
    background: #313244
    color: #fab387
    borderRadius: 8px
    padding: 10px
}

Checkbox#CheckRemember {
    color: #cdd6f4
    fontSize: 13px
}

Checkbox#CheckSSL {
    color: #a6e3a1
    fontSize: 13px
}

Button#BtnConnexion {
    background: #89b4fa
    color: #11111b
    fontSize: 15px
    font: bold
    borderRadius: 8px
    padding: 10px 20px
}

Button#BtnAnnuler {
    background: #45475a
    color: #cdd6f4
    fontSize: 15px
    borderRadius: 8px
    padding: 10px 20px
}
