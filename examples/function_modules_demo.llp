visibility: All

/* ===============================================================
   LLP Demonstration: Function Parameters vs Function Modules
   =============================================================== *\

/*
  1. The Launch function declares:
     - Standard parameters: 'appName' and 'port'
     - An internal module: 'module DevMode then ... end'

  The function contains the implementation of DevMode.
  The developer at call-site chooses whether to enable DevMode
  and configure what DevMode is allowed to inspect or test.
*\
function Launch(appName, port) then
    print("[1] Standard startup of:", appName, "on port:", port)

    /- Internal DevMode module: executed only if enabled during call \
    module DevMode then
        print("  -> 🔧 [MODULE DevMode ACTIVATED]")
        print("  -> Developer privileges granted to test and inject runtime values.")
        print("  -> Admin interface and server network inspector enabled.")

        /- The module checks developer-configured permissions \
        if DevMode.canBypassSecurity == True then
            print("  -> [DEV ALERT] Security bypass ENABLED by developer.")
        else
            print("  -> [DEV SECURITY] Security validation enforced for test.")
        end

        if DevMode.canInspectServerData == True then
            print("  -> [DEV NETWORK] Live server request/response inspector ON.")
        end
    end

    print("[2] Application ready for use.")
end

print("=== TEST A: Standard call without DevMode module ===")
Launch("MyApplication", 8080)

print("\n=== TEST B: Call with simple DevMode activation ===")
Launch("MyApplication", 8080, DevMode: True)

print("\n=== TEST C: Call with granular DevMode permission configuration ===")
General devOptions = Instance.new("DevConfig")
devOptions.canBypassSecurity = False
devOptions.canInspectServerData = True

Launch("MyApplication", 8080, DevMode: devOptions)
