// ===================================================
// Example 2: Hierarchical Parent-Child Application (LLP)
// Demonstration: 
// 1. Service & Instance Parent-Child Hierarchy Tree
// 2. Page Navigation (button click to navigate to another page)
// 3. Displaying a Page on Top of a Page (Modal / Nested Subpage Overlay)
// ===================================================

print("===================================================")
print("   Hierarchical Application & UI Navigation (LLP)")
print("===================================================")

// ---------------------------------------------------
// PART 1: System Services Architecture
// ---------------------------------------------------
General appSystem = Instance.new("AppSystem")
appSystem.Name = "LolpaonOS"

General servicesFolder = Instance.new("Folder", appSystem)
servicesFolder.Name = "Services"

General authService = Instance.new("AuthService", servicesFolder)
authService.Name = "Auth"

General storageService = Instance.new("StorageService", servicesFolder)
storageService.Name = "Storage"

print("\n[Registered System Services]")
for s in servicesFolder.GetChildren() {
    print(" - Service:", s.Name, "| Class:", s.ClassName)
}

// ---------------------------------------------------
// PART 2: User Interface & Multi-Page Setup
// ---------------------------------------------------
print("\n[User Interface Architecture]")

// Root window of the application
General appWindow = Instance.new("Window", appSystem)
appWindow.Name = "MainWindow"
appWindow.Title = "Lolpaon Application Manager"
appWindow.CurrentPage = "LoginPage"

// PAGE 1: Login Page
General loginPage = Instance.new("Page", appWindow)
loginPage.Name = "LoginPage"
loginPage.Title = "User Login"
loginPage.IsVisible = true

General usernameInput = Instance.new("TextInput", loginPage)
usernameInput.Name = "UsernameInput"
usernameInput.Placeholder = "Username"

General passwordInput = Instance.new("TextInput", loginPage)
passwordInput.Name = "PasswordInput"
passwordInput.Placeholder = "Password"

General loginBtn = Instance.new("Button", loginPage)
loginBtn.Name = "BtnLogin"
loginBtn.Text = "Sign In"
loginBtn.TargetPage = "CatalogPage"

// PAGE 2: Product Catalog Page
General catalogPage = Instance.new("Page", appWindow)
catalogPage.Name = "CatalogPage"
catalogPage.Title = "Product Catalog & Inventory"
catalogPage.IsVisible = false

General logoutBtn = Instance.new("Button", catalogPage)
logoutBtn.Name = "BtnLogout"
logoutBtn.Text = "⮌ Sign Out"
logoutBtn.TargetPage = "LoginPage"

General openModalBtn = Instance.new("Button", catalogPage)
openModalBtn.Name = "BtnAddProduct"
openModalBtn.Text = "➕ Add Product (Open Page on Page)"

// PAGE ON PAGE: Modal Window (Nested child page of CatalogPage)
General addProductModal = Instance.new("ModalPage", catalogPage)
addProductModal.Name = "ModalAddProduct"
addProductModal.Title = "New Product (Page on Page)"
addProductModal.IsVisible = false // Hidden by default

General modalNameInput = Instance.new("TextInput", addProductModal)
modalNameInput.Name = "ModalProductName"
modalNameInput.Placeholder = "New product name"

General modalSubmitBtn = Instance.new("Button", addProductModal)
modalSubmitBtn.Name = "BtnSubmitProduct"
modalSubmitBtn.Text = "Save Product"

General modalCloseBtn = Instance.new("Button", addProductModal)
modalCloseBtn.Name = "BtnCloseModal"
modalCloseBtn.Text = "✕ Close"

print("✓ UI hierarchy initialized successfully.")
print("  - Initial active page:", appWindow.CurrentPage)
print("  - Elements on", loginPage.Name, ":")
for el in loginPage.GetChildren() {
    print("    * [", el.ClassName, "]", el.Name)
}

// ---------------------------------------------------
// PART 3: User Interaction Simulation
// ---------------------------------------------------
print("\n[Simulation: Navigation & Page on Page Overlay]")

// 1. Click login button to navigate to another page
print("\n>>> Event: User clicks '", loginBtn.Text, "' (", loginBtn.Name, ")")
print("    Detected action: Navigate to target page:", loginBtn.TargetPage)

loginPage.IsVisible = false
catalogPage.IsVisible = true
appWindow.CurrentPage = loginBtn.TargetPage

print("    ✓ Current page:", appWindow.CurrentPage)
print("    ✓ Visibility LoginPage:", loginPage.IsVisible)
print("    ✓ Visibility CatalogPage:", catalogPage.IsVisible)

// 2. Click button to open page on page (Modal)
print("\n>>> Event: User clicks '", openModalBtn.Text, "'")
print("    Detected action: Display sub-page (Page on Page):", addProductModal.Name)

addProductModal.IsVisible = true
print("    ✓ The page on page is now displayed above '", catalogPage.Name, "'!")
print("    ✓ Page on page title:", addProductModal.Title)
print("    ✓ Modal visibility status:", addProductModal.IsVisible)
print("    ✓ Modal children:")
for mEl in addProductModal.GetChildren() {
    print("      - [", mEl.ClassName, "]", mEl.Name, "(Text/Placeholder:", mEl.Placeholder, ")")
}

// 3. Close the page on page
print("\n>>> Event: User clicks '", modalCloseBtn.Text, "'")
addProductModal.IsVisible = false
print("    ✓ The page on page was closed. Back to '", catalogPage.Name, "'.")
print("    ✓ Modal visibility status:", addProductModal.IsVisible)

// 4. Return to home page via logout button
print("\n>>> Event: User clicks '", logoutBtn.Text, "'")
catalogPage.IsVisible = false
loginPage.IsVisible = true
appWindow.CurrentPage = logoutBtn.TargetPage
print("    ✓ Navigated back to:", appWindow.CurrentPage)

print("\n===================================================")
print("   Parent-Child & Navigation Demo Completed!")
print("===================================================")
