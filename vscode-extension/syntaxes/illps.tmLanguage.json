{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "LLP Interface Style",
  "scopeName": "source.illps",
  "patterns": [
    { "include": "#visibility_header" },
    { "include": "#comments" },
    { "include": "#selectors" },
    { "include": "#properties" },
    { "include": "#values" },
    { "include": "#strings" },
    { "include": "#numbers" }
  ],
  "repository": {
    "visibility_header": {
      "patterns": [
        {
          "match": "\\b(visibility)\\s*:\\s*(All|Package|Parent|Private)\\b",
          "captures": {
            "1": { "name": "keyword.control.directive.llp" },
            "2": { "name": "entity.name.type.visibility.llp" }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.custom.llp",
          "begin": "/\\*",
          "end": "(\\*\\\\|\\*/)"
        },
        {
          "name": "comment.line.custom.llp",
          "match": "/-.*$"
        },
        {
          "name": "comment.line.double-slash.llp",
          "match": "//.*$"
        }
      ]
    },
    "selectors": {
      "patterns": [
        {
          "name": "entity.name.tag.illps",
          "match": "\\b(TextInput|Text|ListButton|Button|ItemBox|Image|Background|Grid|Row|Card|Checkbox|ProgressBar|Divider)\\b"
        },
        {
          "name": "entity.other.attribute-name.class.illps",
          "match": "\\.[a-zA-Z0-9_-]+"
        },
        {
          "name": "entity.other.attribute-name.id.illps",
          "match": "#[a-zA-Z0-9_-]+"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "support.type.property-name.illps",
          "match": "\\b(color|background|backgroundColor|font|fontSize|fontFamily|margin|marginTop|marginBottom|marginLeft|marginRight|padding|width|height|minWidth|maxWidth|minHeight|maxHeight|border|borderRadius|shadow|opacity|responsive|align|justify)\\b"
        }
      ]
    },
    "values": {
      "patterns": [
        {
          "name": "support.constant.property-value.illps",
          "match": "\\b(true|false|auto|center|left|right|none|solid|bold|italic)\\b"
        },
        {
          "name": "constant.other.color.rgb-value.illps",
          "match": "#[0-9a-fA-F]{3,8}\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.illps",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.illps",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.illps",
          "match": "\\b[0-9]+(px|%|em|rem)?\\b"
        }
      ]
    }
  }
}
